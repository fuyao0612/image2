BACKEND_PUBLIC_URL=https://your-domain.com
VITE_API_BASE_URL=

MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=image_saas
MYSQL_USER=image_saas_user
MYSQL_PASSWORD=change-app-password
MYSQL_DSN=image_saas_user:change-app-password@tcp(mysql:3306)/image_saas?charset=utf8mb4&parseTime=True&loc=Local

REDIS_PASSWORD=change-redis-password
REDIS_ADDR=redis:6379
REDIS_DB=0

APP_ENV=prod
HTTP_ADDR=:8080
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=ai-image-saas
CORS_ALLOW_ORIGINS=https://your-domain.com
ADMIN_EMAILS=admin@example.com

EMAIL_DELIVERY=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=postmaster@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=AI 生图 SaaS
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=10s

CHECKIN_POINTS=3
IMAGE_COST_POINTS=1
IMAGE_PROVIDER_BATCH_URL=https://image.mentalout.top
IMAGE_PROVIDER_API_BASE_URL=https://chunfeng.mentalout.top
IMAGE_PROVIDER_API_KEY=replace-with-real-provider-key
IMAGE_PROVIDER_TIMEOUT=10m
IMAGE_PROVIDER_POLL_INTERVAL=2s
IMAGE_TASK_STALE_TTL=30m

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CHECKIN_PER_MINUTE=5
RATE_LIMIT_IMAGE_PER_MINUTE=3
RATE_LIMIT_PURCHASE_PER_MINUTE=10
REGISTRATION_ENABLED=true

VITE_REGISTRATION_ENABLED=true

IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_LOCAL_DIR=/app/storage/uploads
IMAGE_STORAGE_PUBLIC_PATH=/uploads
IMAGE_STORAGE_TIMEOUT=30s
IMAGE_STORAGE_MAX_BYTES=26214400

IMAGE_STORAGE_S3_ENDPOINT=
IMAGE_STORAGE_S3_REGION=
IMAGE_STORAGE_S3_BUCKET=
IMAGE_STORAGE_S3_ACCESS_KEY_ID=
IMAGE_STORAGE_S3_SECRET_ACCESS_KEY=
IMAGE_STORAGE_S3_PUBLIC_BASE_URL=
IMAGE_STORAGE_S3_PATH_PREFIX=generated
IMAGE_STORAGE_S3_FORCE_PATH_STYLE=true
IMAGE_STORAGE_S3_DISABLE_SSL=false
